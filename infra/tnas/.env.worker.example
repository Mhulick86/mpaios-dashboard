# Copy to .env.worker in the repo root on the TNAS. Never commit the real file.
# Used by infra/tnas/docker-compose.worker.yml (worker against hosted Supabase).

# ── Where things live on the NAS (adjust to the mount points TOS assigned) ──
MAIOS_DATA_ROOT=/Volume1/maios
MAIOS_DOCKER_ROOT=/Volume2/maios/docker
ORG_SLUG=marketing-powered

# ── Database: hosted Supabase project mpaios-platform, SESSION pooler on port 5432 ──
# Supabase dashboard → Connect → Session pooler. Replace [PASSWORD] with the database password.
DATABASE_URL=postgres://postgres.rxbgikvmussdstsjciwt:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Models: LM Studio on the Mac Studio over Tailscale (LM Link keeps the catalogue in sync) ──
LLM_BASE_URL=http://100.116.63.45:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen2.5-14b-instruct@q4_k_m
EMBEDDINGS_BASE_URL=http://100.116.63.45:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIM=768
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional cloud fallback for claude-* steps
ANTHROPIC_API_KEY=

# ── Knowledge folders: one sub-folder per collection slug under ${MAIOS_DATA_ROOT}/tenants/<org>/kb ──
KB_SCAN_INTERVAL_SEC=300

# ── HTTP / security ──
# Same value goes into Vercel as MAIOS_INTERNAL_KEY. Generate: openssl rand -base64 32
INTERNAL_API_KEY=change-me-long-random
PUBLIC_BASE_URL=https://api.marketingpowered.ai
# Only needed when running the cloudflared service from this compose file (profile "tunnel").
CLOUDFLARE_TUNNEL_TOKEN=
HTTP_STEP_ALLOWLIST=hooks.slack.com,app.asana.com

# ── Providers used by workflow steps ──
ASANA_PAT=
ASANA_WORKSPACE_GID=
SLACK_WEBHOOK_URL=
