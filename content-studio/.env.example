# Node 22.13+ required. LM Studio must be running with its local server enabled.
HOST=127.0.0.1
PORT=4173
DATA_DIR=./data
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_MODEL_BRIEF=
LM_STUDIO_MODEL_DRAFT=
LM_STUDIO_MODEL_GRAPHICS=
LM_STUDIO_MODEL_QA=
LM_STUDIO_API_TOKEN=
LM_STUDIO_MAX_TOKENS=3072
# Approximate maximum context budget in characters for source excerpts (default 13500).
LM_STUDIO_CONTEXT_CHAR_BUDGET=13500
LM_STUDIO_TEMPERATURE=0.55
# Generation streams from the model. The idle timer resets on every chunk, so a slow model is not
# mistaken for a dead one; MODEL_TIMEOUT_MS is only the overall cap for a single generation.
MODEL_IDLE_TIMEOUT_MS=180000
MODEL_TIMEOUT_MS=900000
# Set to false only if your model server cannot stream.
LM_STUDIO_STREAM=true
# Jobs run one at a time by default. Raise only if your model server handles parallel requests.
WORKER_CONCURRENCY=1
# A job that cannot reach the model server waits and retries (15s, 45s, ...) before failing.
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=15000
AUTO_GENERATE_ON_MOVE=true
# Security for remote API access. REQUIRED if HOST=0.0.0.0 or other non-loopback interface.
MAIOS_API_TOKEN=
# Set to the Vercel UI domain when hosting the frontend separately.
# CORS_ORIGIN=https://content-studio.example.com
CORS_ORIGIN=

# Optional integrations. Easier to set in the app under Settings; values saved there win over these.
# Gemini image generation (paid image models; needs billing on the key's AI Studio project).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Google Docs review links: a "Desktop app" OAuth client with the Google Drive API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set before the first run if you do not want SAMPLE tasks.
NO_DEMO_SEED=0
