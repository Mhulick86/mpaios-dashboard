# Supabase (cloud today; self-hosted on the TNAS after the rebuild — see infra/tnas/README.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth for integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MAIOS worker (ETL agent, knowledge search, workflow engine)
MAIOS_WORKER_URL=http://localhost:8787
MAIOS_INTERNAL_KEY=dev-key
# Dev only: which profile anonymous sessions act as when evaluating collection access
MAIOS_DEFAULT_USER_ID=
# Shown in the Workflows page for webhook URLs (public worker origin)
NEXT_PUBLIC_MAIOS_PUBLIC_URL=http://localhost:8787

# ── Access control (see docs/adr/0005-google-sso-and-roles.md) ──
# Only Google accounts on this Workspace domain may sign in (checked in the OAuth hd hint,
# the auth callback/middleware, and the profiles trigger). No leading "@".
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=marketingpowered.ai
# The single owner / super admin. Seeded as role=owner on first sign-in; everyone else starts as member.
NEXT_PUBLIC_OWNER_EMAIL=mhulick@marketingpowered.ai
# Canonical origin of this deployment; used for OAuth redirects and absolute links.
NEXT_PUBLIC_SITE_URL=https://maios.marketingpowered.ai

# ── Server-side model provider keys ──
# Standard members cannot enter their own keys (Settings is admin-only), so Chat/agents fall back
# to these on the server. Set them in Vercel; never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
PERPLEXITY_API_KEY=
