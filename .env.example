# Supabase (cloud today; self-hosted on the TNAS after the rebuild — see infra/tnas/README.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth for integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MAIOS worker (ETL agent, knowledge search, workflow engine)
MAIOS_WORKER_URL=http://localhost:8787
MAIOS_INTERNAL_KEY=dev-key
# Dev only: which profile anonymous sessions act as when evaluating collection access
MAIOS_DEFAULT_USER_ID=
# Shown in the Workflows page for webhook URLs (public worker origin)
NEXT_PUBLIC_MAIOS_PUBLIC_URL=http://localhost:8787

# ── Access control (see docs/adr/0005-google-sso-and-roles.md) ──
# Only Google accounts on this Workspace domain may sign in (checked in the OAuth hd hint,
# the auth callback/middleware, and the profiles trigger). No leading "@".
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=marketingpowered.ai
# The single owner / super admin. Seeded as role=owner on first sign-in; everyone else starts as member.
NEXT_PUBLIC_OWNER_EMAIL=mhulick@marketingpowered.ai
# Canonical origin of this deployment; used for OAuth redirects and absolute links.
NEXT_PUBLIC_SITE_URL=https://maios.marketingpowered.ai

# ── Server-side model provider keys ──
# Standard members cannot enter their own keys (Settings is admin-only), so Chat/agents fall back
# to these on the server. Set them in Vercel; never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
PERPLEXITY_API_KEY=

# ── Platform integrations (Platforms grid on /integrations; see docs/integrations.md) ──
# 32-byte key that encrypts stored platform tokens (AES-256-GCM). Required before anything can be connected.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENCRYPTION_KEY=
# Google Ads and Google Business Profile reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above; add
# https://maios.marketingpowered.ai/api/integrations/<id>/callback (and the localhost variant) as redirect URIs.
# Google Ads API developer token (Google Ads manager account → Tools → API Center). Basic access needs Google's approval.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: manager (MCC) customer id, digits only, when client accounts are reached through a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Meta Ads app (Marketing API + Facebook Login). Still used by the legacy /meta-ads page.
META_APP_ID=
META_APP_SECRET=
# LinkedIn Ads app with the Advertising API (Marketing Developer Platform) product approved.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# TikTok Marketing API app (business-api.tiktok.com/portal); must be approved by TikTok.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Pinterest app (developers.pinterest.com); starts with trial access, apply for standard access for clients.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# HubSpot public app from the developer account (app.hubspot.com/developer).
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Slack app (api.slack.com/apps); redirect URLs must be https, so use a tunnel for local development.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Semrush Analytics API key — optional; can also be pasted into the Semrush card in the grid.
SEMRUSH_API_KEY=
