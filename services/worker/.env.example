# ── Database (self-hosted Supabase on the TNAS, or infra/dev locally) ──
DATABASE_URL=postgres://maios:maios@localhost:5433/maios
REDIS_URL=redis://localhost:6380

# ── Models (LM Studio on the Mac / Mac Studio, reachable over Tailscale via LM Link) ──
# LM Studio exposes an OpenAI-compatible API. From the TNAS use the Tailscale IP, e.g. http://100.103.155.110:1234/v1
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen2.5-14b-instruct@q4_k_m
EMBEDDINGS_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIM=768
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional fallbacks
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=

# ── Knowledge base folders on the TNAS (one sub-folder per collection slug) ──
# e.g. /maios/tenants/marketing-powered/kb/company-kb/*.md
KB_ROOT=/maios/tenants/marketing-powered/kb
KB_SCAN_INTERVAL_SEC=300
ORG_SLUG=marketing-powered

# ── HTTP ──
WORKER_HTTP_PORT=8787
INTERNAL_API_KEY=change-me
PUBLIC_BASE_URL=https://api.marketingpowered.ai

# ── Providers ──
ASANA_PAT=
ASANA_WORKSPACE_GID=
SLACK_WEBHOOK_URL=
